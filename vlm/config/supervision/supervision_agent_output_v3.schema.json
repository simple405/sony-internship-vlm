{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.sony-internship/vlm/schemas/supervision_agent_output_v3_final.schema.json",
  "title": "Anime IP Merchandise Supervision Agent Output v3 (Finalized)",
  "description": "Rule-level output contract for a VLM supervision agent. This is the finalized version with the 'invisible + correct' convention: when a feature is invisible on a given view, status MUST be 'correct' (not 'correct invisible').",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task",
    "sample_id",
    "category",
    "inputs",
    "overall_decision",
    "rules"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "supervision_agent_output.v3"
    },
    "task": {
      "type": "string",
      "const": "anime_ip_merchandise_multiview_supervision"
    },
    "sample_id": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "type": "string",
      "enum": [
        "backpack",
        "cake_roll",
        "dataset_figurine",
        "dataset_QSitFigures",
        "head_key_chain",
        "plush",
        "dataset_BackPack",
        "dataset_cakeroll",
        "dataset_plush",
        "dataset_QHeadPlush"
      ]
    },
    "product_type": {
      "type": "string",
      "description": "Optional normalized product type if different from category."
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "images",
        "atomic_rules_path"
      ],
      "properties": {
        "images": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/image_ref"
          }
        },
        "atomic_rules_path": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "overall_decision": {
      "type": "string",
      "description": "Sample-level summary derived from rule-level judgments.",
      "enum": [
        "pass",
        "minor_issue",
        "fail",
        "unsure"
      ]
    },
    "overall_reason": {
      "type": "string",
      "description": "Short human-readable explanation for the overall decision."
    },
    "aggregate_counts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "total_rules": {
          "type": "integer",
          "minimum": 0
        },
        "correct_rules": {
          "type": "integer",
          "minimum": 0
        },
        "wrong_rules": {
          "type": "integer",
          "minimum": 0
        },
        "unsure_rules": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/rule_judgment_v3"
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true,
      "description": "Optional provenance such as model name, prompt version, run id, or decoding parameters."
    }
  },
  "$defs": {
    "image_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "path"
      ],
      "properties": {
        "role": {
          "type": "string",
          "enum": [
            "source_2d",
            "generated_product",
            "multiview_design",
            "reference",
            "other"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "visible_value": {
      "type": "string",
      "enum": [
        "visible",
        "invisible"
      ]
    },
    "view_status_visible": {
      "type": "string",
      "description": "Status values allowed when visible=visible. 'correct' means the feature matches the source. The other three are error types.",
      "enum": [
        "correct",
        "wrong color",
        "wrong shape",
        "extra"
      ]
    },
    "view_status_invisible": {
      "type": "string",
      "description": "Status values allowed when visible=invisible. 'correct' means the invisibility is expected and acceptable. 'wrong invisible' means the feature should have been visible but is missing.",
      "enum": [
        "correct",
        "wrong invisible"
      ]
    },
    "view_status": {
      "type": "string",
      "description": "Union of all status values. The conditional constraints (allOf below) enforce which subset applies based on the visible value.",
      "enum": [
        "correct",
        "wrong color",
        "wrong shape",
        "extra",
        "wrong invisible"
      ]
    },
    "rule_judgment_v3": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "value",
        "front_visible",
        "front_status",
        "side_visible",
        "side_status",
        "back_visible",
        "back_status",
        "result",
        "confidence",
        "reason"
      ],
      "properties": {
        "rule_id": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "string"
        },
        "front_visible": {
          "$ref": "#/$defs/visible_value"
        },
        "front_status": {
          "$ref": "#/$defs/view_status"
        },
        "side_visible": {
          "$ref": "#/$defs/visible_value"
        },
        "side_status": {
          "$ref": "#/$defs/view_status"
        },
        "back_visible": {
          "$ref": "#/$defs/visible_value"
        },
        "back_status": {
          "$ref": "#/$defs/view_status"
        },
        "result": {
          "type": "string",
          "enum": [
            "correct",
            "wrong",
            "unsure"
          ]
        },
        "issue_type": {
          "type": "string",
          "enum": [
            "none",
            "wrong color",
            "wrong shape",
            "extra",
            "wrong invisible",
            "ambiguous",
            "other"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "reason": {
          "type": "string",
          "description": "Concise reason in Chinese or English. Must be non-empty when result is wrong or unsure."
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence_item"
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "front_visible": { "const": "visible" } } },
          "then": { "properties": { "front_status": { "$ref": "#/$defs/view_status_visible" } } }
        },
        {
          "if": { "properties": { "front_visible": { "const": "invisible" } } },
          "then": { "properties": { "front_status": { "$ref": "#/$defs/view_status_invisible" } } }
        },
        {
          "if": { "properties": { "side_visible": { "const": "visible" } } },
          "then": { "properties": { "side_status": { "$ref": "#/$defs/view_status_visible" } } }
        },
        {
          "if": { "properties": { "side_visible": { "const": "invisible" } } },
          "then": { "properties": { "side_status": { "$ref": "#/$defs/view_status_invisible" } } }
        },
        {
          "if": { "properties": { "back_visible": { "const": "visible" } } },
          "then": { "properties": { "back_status": { "$ref": "#/$defs/view_status_visible" } } }
        },
        {
          "if": { "properties": { "back_visible": { "const": "invisible" } } },
          "then": { "properties": { "back_status": { "$ref": "#/$defs/view_status_invisible" } } }
        }
      ]
    },
    "evidence_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "view",
        "note"
      ],
      "properties": {
        "view": {
          "type": "string",
          "enum": [
            "front",
            "side",
            "back",
            "overall"
          ]
        },
        "source_region": {
          "type": "string"
        },
        "generated_region": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      }
    }
  }
}
